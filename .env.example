ML_CLIENT_ID=your_app_id_here
ML_CLIENT_SECRET=your_client_secret_here
ML_SITE_ID=MLB
ML_REDIRECT_URI=http://localhost:3333/callback

# Seguranca: "true" bloqueia todas as ferramentas de escrita (padrao: true)
ML_READ_ONLY=true

# Perfil de ferramentas expostas: all | leitura | vendas | publicacao (padrao: leitura)
ML_TOOL_PROFILE=leitura
